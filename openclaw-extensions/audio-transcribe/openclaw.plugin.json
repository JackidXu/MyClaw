{
  "id": "audio-transcribe",
  "name": "AudioTranscribe",
  "description": "Audio speech-to-text transcription powered by HeyClaw and Volcano Engine ASR.",
  "contracts": {
    "tools": [
      "heyclaw_audio_transcribe"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "callbackUrl": {
        "type": "string",
        "description": "HeyClaw HTTP callback URL for audio transcription requests"
      },
      "secret": {
        "type": "string",
        "description": "Shared secret for callback authentication"
      },
      "requestTimeoutMs": {
        "type": "number",
        "minimum": 1000,
        "description": "Request timeout in milliseconds"
      }
    }
  }
}
